{
  "schema_version": 1,
  "package_name": "SRWF_GPT_Project_Package",
  "version_source": "bundle/VERSION",
  "output_pattern": "dist/SRWF_GPT_Project_Package_v{version}.zip",
  "purpose": "Portable ChatGPT Project knowledge/orchestration snapshot compiled from the accepted SRWF repository. GitHub main remains the live project/runtime SSOT.",
  "builder_profile": "BUNDLE_PACKAGE_MAKER_5_COMPATIBILITY",
  "formal_package_maker_5_spec_status": "NOT_RETRIEVED",
  "compatibility_basis": [
    "observed prior GPT Project package convention with 02_PROJECT_INSTRUCTIONS.md + PROJECT_SOURCES",
    "observed repository-first portable bundle convention: repository remains SSOT; ZIP is compiled consumption artifact",
    "deterministic sorted ZIP entries with per-file SHA-256 manifest"
  ],
  "authority_rule": "WHEN_REPOSITORY_AVAILABLE_GITHUB_MAIN_WINS",
  "snapshot_fallback_rule": "Bundle runtime state is BUILD_TIME_FALLBACK_ONLY and cannot receive/persist new runtime state.",
  "top_level_files": [
    "bundle/00_README.md",
    "bundle/02_PROJECT_INSTRUCTIONS.md"
  ],
  "canonical_source_mappings": {
    "README.md": "PROJECT_SOURCES/00_REPOSITORY_README.md",
    "AGENTS.md": "PROJECT_SOURCES/01_AGENT_ENTRYPOINT.md",
    "repository.manifest.yaml": "PROJECT_SOURCES/02_REPOSITORY_MANIFEST.yaml",
    "docs/authority/MASTER.md": "PROJECT_SOURCES/03_MASTER_AUTHORITY.md",
    "docs/operations/EXECUTION_PLAYBOOK.md": "PROJECT_SOURCES/04_EXECUTION_PLAYBOOK.md",
    "docs/governance/KNOWLEDGE_COMPOSITION_ADDENDUM.md": "PROJECT_SOURCES/05_KNOWLEDGE_COMPOSITION_ADDENDUM.md",
    "docs/governance/OWNER_COMPREHENSION_PROTOCOL.md": "PROJECT_SOURCES/06_OWNER_COMPREHENSION_PROTOCOL.md",
    "docs/governance/DECISION_LEDGER.md": "PROJECT_SOURCES/07_DECISION_LEDGER.md",
    "docs/governance/RISK_REGISTER.md": "PROJECT_SOURCES/08_RISK_REGISTER.md",
    "docs/governance/MINIMALITY_CHALLENGE.md": "PROJECT_SOURCES/09_MINIMALITY_CHALLENGE.md",
    "docs/governance/REMAINING_OWNER_BINDINGS.md": "PROJECT_SOURCES/10_REMAINING_OWNER_BINDINGS.md",
    "docs/contracts/SEMANTIC_FIELD_CONTRACT.yaml": "PROJECT_SOURCES/11_SEMANTIC_FIELD_CONTRACT.yaml",
    "docs/contracts/SEMANTIC_FIELD_CONTRACT.md": "PROJECT_SOURCES/12_SEMANTIC_FIELD_CONTRACT.md",
    "docs/contracts/WORKFLOW_CONTRACT.md": "PROJECT_SOURCES/13_WORKFLOW_CONTRACT.md",
    "docs/contracts/ACCESS_CONTROL_CONTRACT.md": "PROJECT_SOURCES/14_ACCESS_CONTROL_CONTRACT.md",
    "docs/contracts/IMPLEMENTATION_MAPPING.yaml": "PROJECT_SOURCES/15_IMPLEMENTATION_MAPPING.yaml",
    "docs/contracts/IMPLEMENTATION_MAPPING.md": "PROJECT_SOURCES/16_IMPLEMENTATION_MAPPING.md",
    "docs/contracts/ENVIRONMENT_MANIFEST.md": "PROJECT_SOURCES/17_ENVIRONMENT_MANIFEST.md",
    "docs/contracts/PRIVACY_RETENTION_CONTRACT.md": "PROJECT_SOURCES/18_PRIVACY_RETENTION_CONTRACT.md",
    "docs/validation/TEST_MATRIX.md": "PROJECT_SOURCES/19_TEST_MATRIX.md",
    "docs/validation/DEFINITION_OF_DONE.md": "PROJECT_SOURCES/20_DEFINITION_OF_DONE.md",
    "docs/validation/POC_REGISTER.md": "PROJECT_SOURCES/21_POC_REGISTER.md",
    "docs/release/RELEASE_MANIFEST.md": "PROJECT_SOURCES/22_RELEASE_MANIFEST.md",
    "docs/release/ROLLBACK_RUNBOOK.md": "PROJECT_SOURCES/23_ROLLBACK_RUNBOOK.md",
    "runtime/CURRENT_STATE.yaml": "PROJECT_SOURCES/24_CURRENT_STATE.yaml",
    "runtime/DECISION_HISTORY.jsonl": "PROJECT_SOURCES/25_DECISION_HISTORY.jsonl",
    "runtime/README.md": "PROJECT_SOURCES/26_RUNTIME_STATE_CONTRACT.md",
    "knowledge/constructability/APPLICABILITY_OVERLAY.md": "PROJECT_SOURCES/27_CONSTRUCTABILITY_APPLICABILITY_OVERLAY.md",
    "evidence/provenance/SOURCE_MANIFEST.yaml": "PROJECT_SOURCES/28_SOURCE_MANIFEST.yaml",
    "history/pre-runtime-ssot/DECISION_HISTORY_INDEX.json": "PROJECT_SOURCES/29_PRE_CUTOVER_DECISION_INDEX.json",
    "history/pre-runtime-ssot/MIGRATION_MANIFEST.json": "PROJECT_SOURCES/30_RUNTIME_MIGRATION_MANIFEST.json"
  },
  "materialized_knowledge_sources": {
    "04_SRWF_CONSTRUCTABILITY_RUNTIME_KNOWLEDGE.txt": "PROJECT_SOURCES/KNOWLEDGE/04_SRWF_CONSTRUCTABILITY_RUNTIME_KNOWLEDGE.txt",
    "05_PRODUCT_KNOWLEDGE_NORMALIZED.txt": "PROJECT_SOURCES/KNOWLEDGE/05_PRODUCT_KNOWLEDGE_NORMALIZED.txt",
    "06_GRAVITY_FORMS_PRODUCT_KNOWLEDGE.txt": "PROJECT_SOURCES/KNOWLEDGE/06_GRAVITY_FORMS_PRODUCT_KNOWLEDGE.txt",
    "07_GRAVITY_FLOW_PRODUCT_KNOWLEDGE.txt": "PROJECT_SOURCES/KNOWLEDGE/07_GRAVITY_FLOW_PRODUCT_KNOWLEDGE.txt",
    "08_GRAVITYVIEW_PRODUCT_KNOWLEDGE.txt": "PROJECT_SOURCES/KNOWLEDGE/08_GRAVITYVIEW_PRODUCT_KNOWLEDGE.txt",
    "09_GRAVITY_PERKS_PRODUCT_KNOWLEDGE.txt": "PROJECT_SOURCES/KNOWLEDGE/09_GRAVITY_PERKS_PRODUCT_KNOWLEDGE.txt"
  },
  "include_pre_cutover_history": true,
  "include_pre_repository_archive": true,
  "referenced_artifacts_policy": "If an artifact is named/hash-recorded in runtime history but its exact bytes are not present in the repository, record it as REFERENCED_NOT_EMBEDDED; never reconstruct it from description.",
  "forbidden": [
    ".git/",
    "dist/",
    "node_modules/",
    ".env",
    "real PII",
    "real intake images",
    "operational ledgers containing real records",
    "credentials/secrets"
  ]
}
